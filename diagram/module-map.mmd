%% Mini Coding Agent 当前实现的模块关系（MVP-0.9 之后）。
%% 连线取自真实的 app 内部 import 关系，省略了纯数据类型模块之间的连边。
flowchart LR
    subgraph CLI[入口 app/cli]
        Main["main.py<br/>Typer 参数 / 会话 / --yes"]
        Report["report.py<br/>文本与 JSON 报告"]
        Main --> Report
    end

    subgraph PLAN[计划层 app/core]
        Agent["agent.py<br/>组装依赖 / 产出 TaskResult"]
        Runner["runner.py<br/>TaskRunner 执行内核"]
        Planner["planner.py<br/>意图 + 验收 + 步骤"]
        Lint["plan_lint.py<br/>L1–L6 可执行性校验"]
        Intent["intent.py<br/>目标 / 范围 / 验收项"]
        Complexity["complexity.py<br/>简单 vs 复杂"]
        State["task_state.py<br/>步骤状态机与阶段判定"]
        Context["context.py<br/>消息与上下文裁剪"]
    end

    subgraph VERIFY[判定与恢复 app/core]
        Completion["completion.py<br/>完成判定"]
        Acceptance["acceptance.py<br/>验收项取证"]
        Requirements["requirements.py<br/>显式需求核验"]
        Safety["task_safety.py<br/>约束 / 变更 / 测试门控"]
        Recovery["recovery.py<br/>恢复决策与熔断"]
        Aggregator["result_aggregator.py<br/>聚合 TaskResult"]
        FinalVerify["final_verification.py<br/>最终状态核验"]
        TaskResult["task_result.py<br/>结构化结果模型"]
    end

    subgraph RUNTIME[运行时 app/runtime]
        Model["model.py<br/>模型适配与故障切换"]
        Provider["provider.py<br/>多模型配置"]
        Config["config.py<br/>环境配置"]
        Explorer["explorer.py<br/>项目快照"]
        Trace["trace.py<br/>结构化事件"]
        Workspace["workspace.py<br/>工作区边界"]
    end

    subgraph TOOLS[工具 app/tools]
        Registry["registry.py<br/>注册 / 校验 / 授权 / 执行"]
        FileTools["tools.py<br/>文件与测试工具"]
        GitTools["git_tools.py<br/>只读 Git"]
        Auth["authorization.py<br/>交互式 / 自动授权"]
        ChangeSet["change_set.py<br/>任务变更集"]
        Rollback["rollback.py<br/>授权回滚"]
        ToolResult["result.py<br/>ToolResult"]
    end

    Main --> Agent
    Agent --> Runner
    Agent --> Context
    Agent --> Model
    Agent --> Registry
    Agent --> Trace
    Agent --> FinalVerify
    Agent --> Aggregator

    Runner --> Planner
    Runner --> State
    Runner --> Safety
    Runner --> Completion
    Runner --> Acceptance
    Runner --> Requirements
    Runner --> Context
    Runner --> Recovery
    Runner --> Trace
    Runner --> Registry

    Planner --> Complexity
    Planner --> Intent
    Planner --> Lint
    Lint --> Intent
    State --> Planner

    Completion --> Acceptance
    Completion --> TaskResult
    Acceptance --> Intent
    Acceptance --> ChangeSet
    Safety --> Recovery
    Safety --> ChangeSet
    Safety --> Rollback
    Recovery --> Completion
    Aggregator --> TaskResult
    Aggregator --> FinalVerify

    Registry --> FileTools
    Registry --> GitTools
    Registry --> Auth
    Registry --> ToolResult
    FileTools --> Workspace
    GitTools --> Workspace
    ChangeSet --> Workspace
    Rollback --> ChangeSet
    Explorer --> Workspace
    Model --> Provider
    Model --> Config
