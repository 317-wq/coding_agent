# ===== 模型 provider（新格式，推荐） =====
# 每个 provider 对应一个 OpenAI 兼容服务。
# MODELS 用英文逗号分隔；同一 provider 内按顺序故障转移，
# 多个 provider 之间按序号顺序切换（最多 5 个）。
MODEL_PROVIDER_1_NAME=qwen
MODEL_PROVIDER_1_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_PROVIDER_1_API_KEY=
MODEL_PROVIDER_1_MODELS=qwen3.7-flash,qwen3.8-max

# 可选：第二个 provider，第一个整体耗尽时切换
# MODEL_PROVIDER_2_NAME=backup
# MODEL_PROVIDER_2_BASE_URL=https://example.com/v1
# MODEL_PROVIDER_2_API_KEY=
# MODEL_PROVIDER_2_MODELS=model-a,model-b

# ===== 旧格式（兼容保留；新格式存在时忽略） =====
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_CHAT_MODEL_1=qwen3.7-flash
